# Browser-safe (Vite inlines VITE_* into the client bundle)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_MAPBOX_TOKEN=

# Server-only — set in Vercel Preview + Production separately; never prefix with VITE_
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PUBLISHABLE_KEY=

# Grafana (server-only). Token must never reach the browser.
GRAFANA_BASE_URL=https://mis.ukdeos.com/mon
GRAFANA_PROMETHEUS_UID=cdmwy4dypbeo0e
GRAFANA_TOKEN=

# Optional compat for GET /api/report-config and POST /api/report-runs.
REPORT_CONFIG_KEY=

# In-app report email (Resend). Heartbeat sends daily/weekly trust reports.
RESEND_API_KEY=
REPORT_FROM_EMAIL=no-reply@mail.thrumble.ai
REPORT_FROM_NAME="Deos Heartbeat"

# Local seed / quick-login password (dev only; optional — seed defaults if unset)
SEED_ADMIN_PASSWORD=

# Unused for now. Authenticator code is skipped in every build (see vite.config.ts).
BYPASS_AUTHENTICATOR=

# Cron auth for /api/uptime and /api/reports/send. Vercel Cron sends Authorization: Bearer $CRON_SECRET.
CRON_SECRET=
UPTIME_WEBHOOK_URL=

# Slack incoming webhook. One message after each successful report send (Supabase secret).
SLACK_REPORT_WEBHOOK_URL=

# Freshdesk (server-only). Tickets are view-only and refresh every 15 minutes.
FRESHDESK_DOMAIN=
FRESHDESK_API_KEY=

# Resend webhook signing secret (whsec_…) for detected report opens.
RESEND_WEBHOOK_SECRET=
