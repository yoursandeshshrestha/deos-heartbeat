# Browser-safe (Vite inlines VITE_* into the client bundle)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only — set in Vercel Preview + Production separately; never prefix with VITE_
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PUBLISHABLE_KEY=

# Grafana (server-only). Token must never reach the browser.
GRAFANA_BASE_URL=https://mis.ukdeos.com/mon
GRAFANA_PROMETHEUS_UID=cdmwy4dypbeo0e
GRAFANA_TOKEN=

# Report workflow API key (server-only). Used by GET /api/report-config and POST /api/report-runs.
REPORT_CONFIG_KEY=

# Local seed / quick-login password (dev only; optional — seed defaults if unset)
SEED_ADMIN_PASSWORD=

# Uptime (optional). Vercel Cron hits /api/uptime every 5 minutes.
CRON_SECRET=
UPTIME_WEBHOOK_URL=
